---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import slugify from 'slugify'
import BlogPostList from '../../components/BlogPostList.astro'

export async function getTagsByPost() {
    const posts = await getCollection('blog')
    const tags = new Map<string, Array<typeof posts[number]>>()
    for(const post of posts) {
        if(post.data.tags === undefined) continue
        for(const tag of post.data.tags) {
            const existingTagList = tags.get(tag)
            if(existingTagList !== undefined) {
                existingTagList.push(post)
            } else {
                tags.set(tag, [post])
            }
        }
    }
    return tags
}

export async function getStaticPaths() {
    const tags = await getTagsByPost()

    return [...tags.entries()].map(([tag, posts]) => ({
        params: {tag: slugify(tag)},
        props: {tag, posts}
    }))
}

const {tag, posts} = Astro.props
---
<Layout title={tag}>
    <h1 class="text-3xl">Posts Tagged <span class="underline underline-offset-8">{tag}</span>:</h1>
    <BlogPostList posts={posts}/>
</Layout>