---
import type { CollectionEntry } from 'astro:content'
import slugify from 'slugify'
import UTCDate from './UTCDate.astro'

export interface Props {
    posts: CollectionEntry<'blog'>[]
}

const sortedPosts = Astro.props.posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---
<table class="border-separate border-spacing-4">
    <tbody>
        {sortedPosts.map(post => (
            <tr>
                <td class="font-light align-middle">
                    <UTCDate date={post.data.date}/>
                </td>
                <td>
                    <a href={'/blog/' + post.id} class="text-2xl">
                        {post.data.title}
                    </a>
                    {post.data.tags !== undefined && <ul>
                        {post.data.tags.map(tag => (
                            <li class="inline">
                                <a href={'/tags/' + slugify(tag)}>#{tag}</a>
                            </li>
                        ))}
                    </ul>}
                </td>
            </tr>
        ))}
    </tbody>
</table>